diff --git a/slab-status.ts b/slab-status.ts
new file mode 100644
index 0000000..5555555
--- /dev/null
+++ b/slab-status.ts
@@ -0,0 +1,126 @@
+import { existsSync, mkdirSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import { dirname } from "node:path";
+import type { McpExtensionState } from "./state.ts";
+import { getAgentPath } from "./agent-dir.ts";
+
+export type SlabMcpServerStatus = "connected" | "needs-auth" | "failed" | "cached" | "not-connected";
+
+export interface SlabMcpServerSnapshot {
+  name: string;
+  status: SlabMcpServerStatus;
+  toolCount: number;
+  failedAgeSeconds?: number;
+}
+
+export interface SlabMcpActivitySnapshot {
+  kind: "connecting";
+  serverName?: string;
+}
+
+export interface SlabMcpStatusSnapshot {
+  version: 1;
+  updatedAt: number;
+  total: number;
+  connected: number;
+  ok: number;
+  cached: number;
+  needsAuth: number;
+  failed: number;
+  totalTools: number;
+  servers: SlabMcpServerSnapshot[];
+  activity?: SlabMcpActivitySnapshot;
+}
+
+const FAILED_STATUS_MAX_AGE_MS = 60 * 1000;
+
+export function getSlabStatusPath(): string {
+  return getAgentPath("mcp-status.json");
+}
+
+export function clearSlabStatus(): void {
+  const path = getSlabStatusPath();
+  try {
+    if (existsSync(path)) rmSync(path);
+  } catch {
+    // best-effort status file cleanup
+  }
+}
+
+export function writeSlabStatus(
+  state: McpExtensionState,
+  activity?: SlabMcpActivitySnapshot
+): SlabMcpStatusSnapshot {
+  const snapshot = buildSlabStatus(state, activity);
+  writeSnapshot(snapshot);
+  return snapshot;
+}
+
+function buildSlabStatus(
+  state: McpExtensionState,
+  activity?: SlabMcpActivitySnapshot
+): SlabMcpStatusSnapshot {
+  const now = Date.now();
+  const servers = Object.keys(state.config.mcpServers).map((name) => {
+    const connection = state.manager.getConnection(name);
+    const metadata = state.toolMetadata.get(name);
+    const failedAgeSeconds = failureAgeSeconds(state, name, now);
+    let status: SlabMcpServerStatus = "not-connected";
+
+    if (connection?.status === "connected") {
+      status = "connected";
+    } else if (connection?.status === "needs-auth") {
+      status = "needs-auth";
+    } else if (failedAgeSeconds !== undefined) {
+      status = "failed";
+    } else if (metadata !== undefined) {
+      status = "cached";
+    }
+
+    return {
+      name,
+      status,
+      toolCount: metadata?.length ?? 0,
+      ...(failedAgeSeconds !== undefined ? { failedAgeSeconds } : {}),
+    } satisfies SlabMcpServerSnapshot;
+  });
+
+  const connected = servers.filter((server) => server.status === "connected").length;
+  const cached = servers.filter((server) => server.status === "cached").length;
+  const needsAuth = servers.filter((server) => server.status === "needs-auth").length;
+  const failed = servers.filter((server) => server.status === "failed").length;
+
+  return {
+    version: 1,
+    updatedAt: now,
+    total: servers.length,
+    connected,
+    ok: connected + cached,
+    cached,
+    needsAuth,
+    failed,
+    totalTools: servers.reduce((sum, server) => sum + server.toolCount, 0),
+    servers,
+    ...(activity ? { activity } : {}),
+  };
+}
+
+function failureAgeSeconds(
+  state: McpExtensionState,
+  serverName: string,
+  now: number
+): number | undefined {
+  const failedAt = state.failureTracker.get(serverName);
+  if (!failedAt) return undefined;
+  const ageMs = now - failedAt;
+  if (ageMs > FAILED_STATUS_MAX_AGE_MS) return undefined;
+  return Math.round(ageMs / 1000);
+}
+
+function writeSnapshot(snapshot: SlabMcpStatusSnapshot): void {
+  const path = getSlabStatusPath();
+  const dir = dirname(path);
+  mkdirSync(dir, { recursive: true });
+  const tmpPath = `${path}.${process.pid}.tmp`;
+  writeFileSync(tmpPath, JSON.stringify(snapshot, null, 2), "utf-8");
+  renameSync(tmpPath, path);
+}
