+const COMMAND_MODEL_CONFIG_PATH =
+    process.env.PI_COMMAND_MODELS_CONFIG ?? `${process.env.HOME ?? "."}/.pi/agent/command-models.json`;
+const COMMAND_THINKING_LEVELS = ["off", "minimal", "low", "medium", "high", "xhigh"];
+
+function readCommandModelConfig(command) {
+    try {
+        const parsed = JSON.parse(readFileSync(COMMAND_MODEL_CONFIG_PATH, "utf8"));
+        if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+            throw new Error(`Invalid command config ${COMMAND_MODEL_CONFIG_PATH}: expected object`);
+        }
+        const entry = parsed[command];
+        if (!entry || typeof entry !== "object" || Array.isArray(entry)) return {};
+        const model = typeof entry.model === "string" && entry.model.trim() ? entry.model.trim() : undefined;
+        const thinking = COMMAND_THINKING_LEVELS.includes(entry.thinking) ? entry.thinking : undefined;
+        return { model, thinking };
+    }
+    catch (error) {
+        if (error?.code === "ENOENT") {
+            return {};
+        }
+        if (error instanceof SyntaxError) {
+            throw new Error(`Invalid JSON in ${COMMAND_MODEL_CONFIG_PATH}: ${error.message}`);
+        }
+        throw error;
+    }
+}
+
+function resolveCommandModel(modelRuntime, spec) {
+    const models = modelRuntime.getModels();
+    const exactFull = models.find((model) => `${model.provider}/${model.id}` === spec);
+    if (exactFull) return exactFull;
+    const slash = spec.indexOf("/");
+    if (slash > 0) {
+        const provider = spec.slice(0, slash);
+        const id = spec.slice(slash + 1);
+        const exactProvider = modelRuntime.getModel(provider, id);
+        if (exactProvider) return exactProvider;
+    }
+    const exactId = models.filter((model) => model.id === spec || model.name === spec);
+    if (exactId.length === 1) return exactId[0];
+    if (exactId.length > 1) return "ambiguous";
+    return undefined;
+}
+
+async function applyCommandModelConfig(session, command) {
+    const config = readCommandModelConfig(command);
+    if (!config.model && !config.thinking) return undefined;
+    const restore = {
+        model: session.model,
+        thinking: session.thinkingLevel,
+    };
+    if (config.model) {
+        const model = resolveCommandModel(session._modelRuntime, config.model);
+        if (model === "ambiguous") {
+            throw new Error(`Ambiguous /${command} model in ${COMMAND_MODEL_CONFIG_PATH}: ${config.model}`);
+        }
+        if (!model) {
+            throw new Error(`Model not found in ${COMMAND_MODEL_CONFIG_PATH}: ${config.model}`);
+        }
+        if (!session._modelRuntime.hasConfiguredAuth(model.provider)) {
+            throw new Error(`No API key for ${model.provider}/${model.id}`);
+        }
+        await session.setModel(model);
+    }
+    if (config.thinking) {
+        session.setThinkingLevel(config.thinking);
+    }
+    return restore;
+}
+
+async function restoreCommandModelConfig(session, restore) {
+    if (!restore) return;
+    if (restore.model) await session.setModel(restore.model);
+    session.setThinkingLevel(restore.thinking);
+}
